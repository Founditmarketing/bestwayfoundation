{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:ssr && npm run sitemap && npm run build:client && npm run prerender",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --logLevel warn",
    "check:hydration": "node scripts/hydration-check.mjs",
    "check:leads": "node scripts/lead-form-check.mjs",
    "clean": "rm -rf dist dist-ssr",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "images": "node scripts/optimize-images.mjs",
    "lint": "tsc --noEmit",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "serve:dist": "node scripts/serve-static.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "verify": "node scripts/verify-seo.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
